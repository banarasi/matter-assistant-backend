ANTHROPIC_API_KEY=sk-ant-...
EXTRACTOR_MODEL=claude-haiku-4-5
CONVERSE_MODEL=claude-sonnet-5
MCP_SERVER_URL=http://localhost:8081/mcp
# true = run the Passport tools in-process over an in-memory store (no MCP server,
# no Postgres; MCP_SERVER_URL ignored) — for UI testing without Docker; see README
USE_STUB_MCP=
AGENT_DATABASE_URL=postgresql://passport:passport@localhost:5433/agent
# postgres (default; durable, uses AGENT_DATABASE_URL) | memory (in-process, lost on
# restart — run the agent API natively with no Docker/Postgres; see README)
AGENT_CHECKPOINTER=postgres
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
# set to empty + a real ANTHROPIC_API_KEY for live Claude; leave true for a key-less
# demo/CI run (StubModelClient, no network calls to Anthropic)
USE_STUB_MODEL=true
